# Supabase Postgres (required). Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

ADMIN_EMAIL=you@opportunitypedia.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Platform Admin

DEMO_EMAIL=demo@opportunitypedia.com
DEMO_PASSWORD=DemoOpportunity2026!
DEMO_NAME=Demo User
DEMO_COMPANY=OpportunityPedia Demo

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8765,http://localhost:8765

ACCESS_AMOUNT_CENTS=4900
ACCESS_AMOUNT_PAISE=4900
ACCESS_CURRENCY=inr
RADAR_MAX_JOBS_PER_BOARD=500

SAM_GOV_API_KEY=
SAM_LOOKBACK_DAYS=365
SAM_NAICS_CODES=561311,561312,561320,561330
SAM_NAICS_QUERY=561311,561312,561320,561330
SAM_MAX_ROWS_PER_CODE=2000
SAM_EXCLUDE_EXPIRED=true
SAM_ENTITY_LOOKUPS=0

RADAR_RUN_COOLDOWN_HOURS=6
RADAR_RUNS_PER_DAY=2
# Local dev only: OP has no sign-in gate yet for reads when set > 0.
OP_PUBLIC_USER_ID=0

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

APP_PUBLIC_URL=http://127.0.0.1:8000
# Frontend origin used in invite / set-password email links
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
# Fail fast on Railway if Hostinger SMTP is unreachable (invite still returns setup URL).
SMTP_TIMEOUT_SECONDS=8
